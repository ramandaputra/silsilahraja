<IfModule mod_rewrite.c>
    RewriteEngine On

    # Only rewrite to public if public directory exists (document root is project root)
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{DOCUMENT_ROOT}/public -d
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Block access to hidden and sensitive files
<FilesMatch "(^\..*|composer\.(json|lock)|package\.(json|lock)|artisan)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
