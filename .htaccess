<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent loop if already pointed to public
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Block access to hidden and sensitive files
<FilesMatch "(^\..*|composer\.(json|lock)|package\.(json|lock)|artisan)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
